{
  "name": "openapi-playwright-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate reviewable Playwright API tests from Swagger and OpenAPI specifications.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "openapi-test-agent": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/cli.test.ts",
    "test:api": "playwright test"
  },
  "dependencies": {
    "@readme/openapi-parser": "^9.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
